---
/**
 * 页内大标题（SSR 静态页版）：装饰图标 + 标题 + 可选副标题。
 * 视觉与 molecules/PageHeader.svelte 完全一致；区别在图标渲染——
 * Svelte 版用 @iconify/svelte，在无 hydration 的静态页上图标为空，
 * 本组件用 astro-icon（构建期内联），供纯 SSR 页面直接使用。
 */
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
	subtitle?: string;
	/** 标题左侧装饰图标（Iconify 名） */
	icon?: string;
	class?: string;
}

const { title, subtitle = "", icon, class: className } = Astro.props;
---

<div class:list={["page-header", className]}>
	<div class="page-header__title-row">
		{icon && (
			<span class="page-header__icon" aria-hidden="true">
				<Icon name={icon} />
			</span>
		)}
		<h1 class="page-header__title">{title}</h1>
	</div>
	{subtitle && <p class="page-header__subtitle">{subtitle}</p>}
</div>

<style lang="stylus">
.page-header
	margin-bottom: 1.5rem

	&__title-row
		display: flex
		align-items: center
		gap: 0.75rem

	&__icon
		display: inline-flex
		flex-shrink: 0
		color: var(--page-header-icon-color, var(--primary))
		> :global(svg)
			width: 2rem
			height: 2rem

	&__title
		margin: 0
		color: var(--page-header-title-color, var(--on-surface))
		font: var(--m3e-type-headline-medium)
		font-weight: 700
		line-height: 1.2

	&__subtitle
		margin: 0.375rem 0 0
		color: var(--page-header-subtitle-color, var(--on-surface-variant))
		font: var(--m3e-type-body-medium)
		line-height: 1.5
</style>
